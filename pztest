#!/usr/bin/env bash
# PZ Test Kit — run tests for a PZ Build 42 mod on PZ's actual Kahlua VM.
#
# Usage (from mod root):
#     pztest                        # run all auto-discovered tests
#     pztest --filter validation    # run only matching tests (plain substrings
#                                   # also pre-skip non-matching files)
#     pztest some/Tests/FooTests.lua  # run a single test file
#     pztest --verbose              # stream all output (default buffers and
#                                   # replays captured output on failure only)
#
# Usage (from elsewhere):
#     pztest /path/to/MyMod         # explicit mod root
#     pztest /path/to/MyMod some/Tests/foo.lua
#
# The script auto-compiles Java sources on first run or when they change.
# On subsequent runs it just invokes the JVM.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
KAHLUA_DIR="$SCRIPT_DIR/kahlua"
JAR="$KAHLUA_DIR/kahlua-runtime.jar"
STUBS="$KAHLUA_DIR/stubs"

if [ ! -f "$JAR" ]; then
    echo "pz-test-kit: cannot find $JAR" >&2
    echo "pz-test-kit: did you clone the repo with LFS or extract the release zip?" >&2
    exit 1
fi

# Classpath separator: ; on Windows (cygwin/msys/gitbash), : elsewhere.
# Also convert POSIX paths to Windows paths when invoking native Java, since
# msys won't auto-translate components of a composite -cp argument.
case "${OSTYPE:-}" in
    msys*|cygwin*|win32)
        CPSEP=';'
        winpath() { cygpath -w "$1"; }
        ;;
    *)
        CPSEP=':'
        winpath() { echo "$1"; }
        ;;
esac

SOURCES=(TestPlatform KahluaTestRunner DualVMSim StubbingClassLoader PZTestKitLauncher ScriptCheck EngineBridge PzLocator)

# Compile into a build directory named for the sources' content, never in
# place. A dashboard VM is a long-lived JVM that loads classes lazily; a run
# that rewrote kahlua/*.class under it (any pztest run after a .java edit)
# left that VM with old classes in memory and new ones on disk -- an inner
# class or lambda loaded later could come from the wrong build. A build dir
# is written once (to a temp name, then renamed into place) and never
# touched again, so every JVM keeps the classes it started with, and a
# source edit simply produces a new directory.
BUILD_ROOT="$KAHLUA_DIR/.build"
if command -v sha1sum >/dev/null 2>&1; then HASHCMD=sha1sum; else HASHCMD="shasum -a 1"; fi
SRC_HASH="$(cd "$KAHLUA_DIR" && cat "${SOURCES[@]/%/.java}" | $HASHCMD | cut -c1-12)"
BUILD_DIR="$BUILD_ROOT/$SRC_HASH"
if [ ! -f "$BUILD_DIR/.complete" ]; then
    echo "[pztest] compiling Java sources -> .build/$SRC_HASH" >&2
    mkdir -p "$BUILD_ROOT"
    TMP_BUILD="$BUILD_ROOT/.tmp-$SRC_HASH-$$"
    rm -rf "$TMP_BUILD"; mkdir -p "$TMP_BUILD"
    (cd "$KAHLUA_DIR" && javac -nowarn -cp "$JAR" -d "$(winpath "$TMP_BUILD")" "${SOURCES[@]/%/.java}") || { rm -rf "$TMP_BUILD"; exit 1; }
    touch "$TMP_BUILD/.complete"
    # Another run may have finished the same build first: theirs wins, ours goes.
    if [ -f "$BUILD_DIR/.complete" ] || ! mv "$TMP_BUILD" "$BUILD_DIR" 2>/dev/null; then rm -rf "$TMP_BUILD"; fi
    # Prune builds nobody has started from in two days (a running VM's build
    # is newer than that or still in use; never prune the current one).
    find "$BUILD_ROOT" -mindepth 1 -maxdepth 1 -type d ! -name "$SRC_HASH" -mtime +2 -exec rm -rf {} + 2>/dev/null || true
fi
touch "$BUILD_DIR" 2>/dev/null || true   # last-used, for the prune

# scriptcheck subcommand — validate media/scripts/*.txt with PZ's OWN parser.
#
# Kept separate from the test run: it needs no pz-test.lua, no Lua and no test
# files, so it works on a mod with no suite at all, and it is the cheapest CI
# gate there is (~1000 files in under a second). See kahlua/ScriptCheck.java.
if [ "${1:-}" = "scriptcheck" ]; then
    shift
    CP_SC="$(winpath "$BUILD_DIR")$CPSEP$(winpath "$JAR")$CPSEP$(winpath "$KAHLUA_DIR")"
    if [ $# -eq 0 ]; then
        if [ ! -d "media/scripts" ]; then
            echo "[scriptcheck] no media/scripts in $(pwd) - nothing to check"
            exit 0
        fi
        set -- "$(winpath "$(pwd)/media/scripts")"
    fi
    exec java -cp "$CP_SC" ScriptCheck "$@"
fi

# apicheck subcommand — do these Lua files call methods PZ actually exposes?
#
# Same shape as scriptcheck and for the same reason: no pz-test.lua, no VM, no
# test files, so it works on a mod with no suite. That is the point. The bugs it
# is built for (calling an invented Java method, reading a public Java field
# Kahlua cannot see, walking a collection with iterator()) fail SILENTLY inside
# a pcall, and they live in adapter files nobody wrote a test for. See
# tools/pz_api_check.py.
if [ "${1:-}" = "apicheck" ]; then
    shift
    if [ $# -eq 0 ] && [ ! -d "media/lua" ]; then
        echo "[apicheck] no media/lua in $(pwd) - nothing to check"
        exit 0
    fi
    exec python "$SCRIPT_DIR/tools/pz_api_check.py" "$@"
fi

# dashboard subcommand — local web UI over every suite in the monorepo: runs,
# results, line coverage over source, resolved config, history. See
# dashboard/server.js. Needs Node; no npm install.
if [ "${1:-}" = "dashboard" ]; then
    shift
    exec node "$SCRIPT_DIR/dashboard/server.js" "$@"
fi

# Init subcommand — scaffolds pz-test.lua + a starter test in the current mod.
if [ "${1:-}" = "init" ]; then
    shift
    target="$(pwd)"
    if [ -f "$target/pz-test.lua" ]; then
        echo "[pztest] $target/pz-test.lua already exists; refusing to overwrite." >&2
        exit 1
    fi
    modname="$(basename "$target")"
    mkdir -p "$target/tests"
    cat > "$target/pz-test.lua" <<EOF
-- pz-test-kit configuration for $modname
-- See https://github.com/4hp-4int/pz-test-kit for the full schema.
return {
    preload = {
        -- "$modname/Core",
    },
    sandbox = {
        -- $modname = { EnableMod = true },
    },
    -- extra_scripts    = { "weapon_scripts.lua" },
    -- test_file_excludes = { "LegacyHub.lua" },
    -- strict_mocks     = true,
}
EOF
    cat > "$target/tests/test_example.lua" <<'EOF'
-- Starter test — delete or replace with your own.
-- `pztest` auto-discovers tests/test_*.lua and media/lua/client/<Mod>/Tests/*.lua.
local Assert = PZTestKit.Assert
local tests = {}

tests["example_truthy"] = function()
    return Assert.isTrue(1 + 1 == 2, "math still works")
end

return tests
EOF
    echo "[pztest] scaffolded $target/pz-test.lua + tests/test_example.lua"
    echo "[pztest] run 'pztest' from this directory to try it."
    exit 0
fi

# STUBS FIRST: the runtime jar bakes a copy of every stub at build time, and
# URLClassLoader searches in order — with the jar first, editing a stub .java
# and recompiling silently changes nothing until the jar is rebuilt (engine
# mode found this the hard way). The live stubs directory is the source of
# truth; the jar's baked copies serve distributions without a stubs/ dir.
# The build dir before KAHLUA_DIR: stale in-place .class files from older
# kits stay shadowed.
CP="$(winpath "$STUBS")$CPSEP$(winpath "$BUILD_DIR")$CPSEP$(winpath "$JAR")$CPSEP$(winpath "$KAHLUA_DIR")"
CWD_ABS="$(winpath "$(pwd)")"

# KahluaTestRunner's resolveKahluaDir() checks cwd for mock_environment.lua.
# We cd into the kit's kahlua/ directory before invoking java. The mod root
# is passed as an absolute path, so the relative cd doesn't hurt discovery.
cd "$KAHLUA_DIR"

# Dispatch: if no args or first arg is a flag, use original cwd as mod root.
if [ $# -eq 0 ] || [[ "$1" == -* ]]; then
    exec java -cp "$CP" PZTestKitLauncher "$CWD_ABS" "$@"
fi

# If first arg looks like a path (directory exists), use as-is. Otherwise
# treat it as a test-file path relative to cwd and insert cwd as mod root.
if [ -d "$(echo "$1" | sed 's/\\/\//g')" ] || [ -d "$1" ]; then
    root="$(winpath "$1")"; shift
    exec java -cp "$CP" PZTestKitLauncher "$root" "$@"
else
    exec java -cp "$CP" PZTestKitLauncher "$CWD_ABS" "$@"
fi
